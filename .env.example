# ── Site ──────────────────────────────────────────────────────────
# Full public URL of this deployment, no trailing slash.
NEXT_PUBLIC_SITE_URL=https://www.kurso.in

# ── Supabase ──────────────────────────────────────────────────────
# Project Settings → API in your Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret. Full read/write access, bypasses Row Level Security. Server-side only.
SUPABASE_SERVICE_ROLE_KEY=

# ── Cloudflare R2 (video/PDF/ebook file storage) ─────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# ── Platform's own payment account (subscriptions + PAYE invoices) ──
# A Cashfree merchant account belonging to whoever operates this
# platform — NOT a creator's account. Used only to bill creators.
# Starts in sandbox so you can test the full billing flow with fake
# money. BEFORE you're ready to actually collect a real payment from a
# real creator, switch BOTH lines below to "production" and replace
# the client ID/secret above with your live (not test) Cashfree
# credentials — sandbox credentials cannot process real money, and
# leaving this on sandbox in a live deployment means no real
# subscription payment will ever actually go through.
KURSO_CASHFREE_CLIENT_ID=
KURSO_CASHFREE_CLIENT_SECRET=
KURSO_CASHFREE_ENV=sandbox          # sandbox | production — see note above
NEXT_PUBLIC_KURSO_CASHFREE_ENV=sandbox   # must match the line above exactly

# Note: this sandbox/production setting only affects the platform's OWN
# billing. It has nothing to do with creator payment gateways — each
# creator chooses sandbox or live for their own connected Cashfree,
# Razorpay, or Stripe account separately, inside their dashboard.

# ── Bot repos (must be running and reachable) ────────────────────
WHATSAPP_BOT_URL=https://your-whatsapp-bot.example
TELEGRAM_BOT_URL=https://your-telegram-bot.example

# ── Shared secret with whatsapp-bot and telegram-bot — same value everywhere ──
INTERNAL_BOT_SECRET=

# ── Public bot identities (shown in UI / used to build links) ────
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=your_bot_username
NEXT_PUBLIC_WHATSAPP_NUMBER=91XXXXXXXXXX

# ── Cron authentication ───────────────────────────────────────────
# Vercel's own cron jobs authenticate to your own cron routes with this.
CRON_SECRET=

# ── Signed-link secrets ────────────────────────────────────────────
# IMPORTANT: set all three of these to the exact SAME value here, and
# use that identical value in Whatsapp-bot's and telegram-bot's env
# too — effectively one shared secret across all three services.
# They're read in a DIFFERENT priority order in each repo (this repo
# and telegram-bot check LESSON_LINK_SECRET first; Whatsapp-bot checks
# WHATSAPP_LINK_SECRET first) — if they're ever set to different
# values, a link signed by one bot will fail verification on the
# website and students will hit "invalid or expired link." Keeping
# all three identical everywhere makes that ordering difference
# harmless.
LESSON_LINK_SECRET=
TELEGRAM_LINK_SECRET=
WHATSAPP_LINK_SECRET=

# ── Encryption key for creator-supplied secrets at rest ──────────
# Used to encrypt creator BYOK payment gateway credentials and Meta
# Pixel access tokens before they're stored. Generate a strong random
# value and never change it after creators start saving credentials —
# changing it makes every previously-saved secret unrecoverable.
CREATOR_SECRETS_KEY=

# ── AI ─────────────────────────────────────────────────────────────
# Powers the AI Doubt Assistant. This is the only AI key actually used.
GEMINI_API_KEY=

# ── Email (Resend) ────────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=Kurso <support@kurso.in>

# ── Operator admin access ─────────────────────────────────────────
# Comma-separated list of email addresses that see the /dashboard/admin
# panel when logged in. No separate admin login system exists.
ADMIN_EMAILS=admin@your-domain.example

# ── Meta Graph API version pin (shared with the bots) ─────────────
META_GRAPH_VERSION=v25.0

# ── Upstash Redis (video-stream rate limiting + enrollment cache) ──
# Free tier is enough at low traffic. Create a database at
# upstash.com/redis, copy these from its REST API section. Read
# automatically by the @upstash/redis SDK (Redis.fromEnv()) in
# src/app/api/video/stream/route.ts — without these, that route's rate
# limiter and enrollment cache silently do nothing, but video streaming
# itself still works (this only affects abuse-prevention, not core function).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=